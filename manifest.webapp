{
  "version": "1.0.0",
  "name": "tsd tool",
  "description": "An ultimate KaiOS dexter tool",
  "launch_path": "/",
  "type": "web",
  "icons": {
    "56": "https://kairoot.thescholarsden.net/img/icon-56.png",
    "112": "https://kairoot.thescholarsden.net/img/icon-112.png"
  },
  "developer": {
    "name": "The Scholars Den",
    "url": "https://thescholarsden.net"
  },
  "origin": "https://kairoot.thescholarsden.net",
  "installs_allowed_from": [
    "*"
  ],
  "permissions": {
    "engmode-extension": {
      "description": "Handle KaiOS 2.5.1+ devices"
    },
    "kaiosextension": {
      "description": "Handle KaiOS 2.5 devices"
    },
    "jrdextension": {
      "description": "Handle KaiOS 1.0 devices by TCL"
    },
    "power": {
      "description": "Enable privileged factory reset capability"
    },
    "settings": {
      "access": "readwrite",
      "description": "Enable hidden settings modification"
    },
    "device-storage:apps": {
      "access": "readwrite",
      "description": "Support package installation"
    },
    "webapps-manage": {
      "description": "Support package installation"
    }
  },
  "theme_color": "#00A859",
  "cursor": "false",
  "default_locale": "en-US",
  "locales": {
    "en-US": {
      "name": "tsd tool",
      "description": "An ultimate KaiOS dexter tool"
    },
    "es": {
      "name": "Herramienta tsd",
      "description": "Una herramienta definitiva para KaiOS"
    },
    "fr": {
      "name": "Outil tsd",
      "description": "Un outil suprême pour KaiOS"
    }
  }
}
